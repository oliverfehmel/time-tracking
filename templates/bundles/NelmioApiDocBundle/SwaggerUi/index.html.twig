{# Swagger UI of NelmioApiDocBundle with a header that leads back into the app instead of the bundle logo. #}
{% extends '@!NelmioApiDoc/SwaggerUi/index.html.twig' %}

{% block header %}
    <a id="logo" href="{{ path('_api_guide') }}" style="color: #fff; text-decoration: none; font-weight: 600; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;">
        ← {{ 'api_guide.back_to_app'|trans }}
    </a>
{% endblock header %}
